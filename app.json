{
  "expo": {
    "name": "YT Music Manager",
    "slug": "yt-music-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ytmusicmanager",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E4B8D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sukarth.ytmusicmanager",
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "UIBackgroundModes": ["audio"],
        "NSMicrophoneUsageDescription": "This app does not use the microphone.",
        "NSAppleMusicUsageDescription": "This app does not use Apple Music."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E4B8D"
      },
      "package": "com.sukarth.ytmusicmanager",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.WAKE_LOCK",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "0315208a-eac4-4e5d-a9e1-e740f414d0da"
      }
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      "expo-audio",
      "expo-file-system",
      "expo-document-picker",
      "expo-secure-store",
      "./plugins/withAndroidSigning",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "owner": "sukarth"
  }
}
