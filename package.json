{
  "name": "yt-music-manager",
  "version": "1.0.0",
  "description": "A React Native mobile app for downloading, syncing and managing YouTube Music playlists for offline playback",
  "main": "index.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sukarth/yt-music-manager.git"
  },
  "keywords": [
    "react-native",
    "youtube-music",
    "downloader",
    "playlist-manager",
    "offline-player",
    "manager"
  ],
  "author": "Sukarth",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Sukarth/yt-music-manager/issues"
  },
  "homepage": "https://github.com/Sukarth/yt-music-manager#readme",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/slider": "5.0.1",
    "@react-native-google-signin/google-signin": "^16.1.1",
    "@react-navigation/bottom-tabs": "^7.9.0",
    "@react-navigation/native": "^7.1.26",
    "@react-navigation/native-stack": "^7.9.0",
    "axios": "^1.13.2",
    "expo": "~54.0.31",
    "expo-audio": "~1.1.1",
    "expo-auth-session": "^7.0.10",
    "expo-build-properties": "^1.0.10",
    "expo-dev-client": "^6.0.20",
    "expo-document-picker": "^14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-intent-launcher": "~13.0.8",
    "expo-notifications": "~0.32.16",
    "expo-secure-store": "^15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "^14.0.9",
    "expo-web-browser": "^15.0.10",
    "patch-package": "^8.0.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-paper": "^5.14.5",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-track-player": "^4.1.2"
  },
  "devDependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "@types/react-native": "^0.72.8",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest-expo": "^54.0.16",
    "prettier": "^3.7.4",
    "typescript": "~5.9.2"
  },
  "private": true
}
